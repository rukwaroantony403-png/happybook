# Required for admin login. Generate unique random values for the deployed server.
ADMIN_USERNAME=admin
ADMIN_NAME=Hotel Administrator
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# SQLite file location. Use a persistent writable disk in production.
# Defaults to ./data/happyland.sqlite
HOTEL_DATABASE_PATH=
# Optional root for room photos. Each category gets its own subfolder (studio, 1-bedroom, 2-bedroom, 3-bedroom).
# Defaults to data/room-media beside the SQLite database.
HOTEL_MEDIA_PATH=

# Optional SMTP. Without these values, enquiries/bookings are still saved in SQLite,
# but confirmation and hotel notification emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HOTEL_NOTIFICATION_EMAIL=

# Production domain, used by the sitemap and robots metadata routes.
HOTEL_SITE_URL=https://booking.happylandhoteldiani.co.ke
